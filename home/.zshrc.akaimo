# brew
if [[ $(uname -m) == arm64 ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# editor
export EDITOR=vim

# direnv
eval "$(direnv hook zsh)"

# mise
eval "$(mise activate zsh)"

# golang
export GOPATH=$HOME/go
export PATH=${GOPATH}/bin:${PATH}

# npm global bin path
export PATH="$PATH:$(npm prefix -g)/bin"


# pnpm
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PATH:$PNPM_HOME/bin" ;;
esac

# bun global bin path
export PATH="$PATH:$HOME/.bun/bin"

# diff-highlight (brew の git 同梱 Perl スクリプトを直接 PATH へ。symlink 管理不要)
path=("${HOMEBREW_PREFIX:-/opt/homebrew}/opt/git/share/git-core/contrib/diff-highlight" $path)

alias gti='git'

# color the diff
if [[ -x `which colordiff` ]]; then
  alias diff='colordiff -u'
else
  alias diff='diff -u'
fi

# less settings
# - color text
# - display line numbers
export LESS='-R'
export LESSOPEN='| /opt/homebrew/bin/src-hilite-lesspipe.sh %s'

# fzf
export FZF_DEFAULT_COMMAND='rg --files --hidden --follow --glob "!.git"'

# jumo
eval "$(jump shell --bind=z)"

# kubectl
alias k='kubectl'
alias kg='kubectl get'
alias kd='kubectl describe'
alias ka='kubectl apply'
alias kl='kubectl logs -f'
alias ke='kubectl exec -it'
alias krm='kubectl delete'
alias wk='watch kubectl'
alias wkg='watch kubectl get'
alias wkd='watch kubectl describe'
source <(kubectl completion zsh)
compdef __start_kubectl k
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

# terraform (op 経由で AWS 認証を注入する。env ファイルは private リポジトリ dotfiles-private が
# ~/.config/op-env/aws_env に配置する。未配置のマシンでは alias を定義せず素の terraform を使う)
if [[ -f "$HOME/.config/op-env/aws_env" ]]; then
  alias tf='op run --env-file=$HOME/.config/op-env/aws_env -- terraform'
  alias tfp='op run --env-file=$HOME/.config/op-env/aws_env -- terraform plan --parallelism=30'
  alias tfa='op run --env-file=$HOME/.config/op-env/aws_env -- terraform apply'
  alias terraform='op run --env-file=$HOME/.config/op-env/aws_env -- terraform'
fi

export GPG_TTY=$(tty)

# gcloud
export PATH=/opt/homebrew/share/google-cloud-sdk/bin:"$PATH"

# claude code
export PATH="$HOME/.local/bin:$PATH"

# 1password
if [[ -f ~/.config/op/plugins.sh ]]; then
  source ~/.config/op/plugins.sh
fi

# my command
fif() {
  if [ ! "$#" -gt 0 ]; then echo "Need a string to search for!"; return 1; fi
  file=$(rg --hidden --files-with-matches --no-messages -g '!.git' "$1" | fzf --preview "highlight -O ansi -l {} 2> /dev/null | rg --colors 'match:bg:yellow' --ignore-case --pretty --context 10 '$1' || rg --ignore-case --pretty --context 10 '$1' {}")
  if [ -n "$file" ]; then
    less ${file}
    echo ${file}
  fi
}

git_history() {
  file=$(rg --files --hidden . | fzf --preview 'cat {}')
  if [ -n "$file" ]; then
    git log -p ${file}
  fi
}

ghro() {
  # gh の読み取り専用ラッパー。読み取り専用の Fine-grained PAT でログイン済みの
  # 専用プロファイル(~/.config/ghro)を使う。
  # 親環境の GH_TOKEN 等は保存済み認証より優先され readonly 境界を破りうるため、
  # unset してから実行する(gcloudro が CLOUDSDK_* を除去するのと同じ防御)。
  command env -u GH_TOKEN -u GITHUB_TOKEN -u GH_ENTERPRISE_TOKEN -u GITHUB_ENTERPRISE_TOKEN \
    GH_CONFIG_DIR="$HOME/.config/ghro" gh "$@"
}

# gcloudro のヘルパーは単一の `_` で始まる名前にしてはいけない。Claude Code は対話シェルの
# 関数定義を shell snapshot に取り込んで非対話シェルで復元するが、`_名前` は zsh の補完関数と
# みなされて除外される(`__名前` は残る)ため、エージェントからの実行時に
# "command not found" になる。
#
# gcloudro 専用: 親環境からの CLOUDSDK_* 注入(API エンドポイント上書き・トークンホスト変更・
# python 差し替え等)を一掃した環境で gcloud を実行する。
# 呼び出し形式: gcloudro_run [-t <上限秒>] [VAR=VAL ...] -- <gcloud 引数>
gcloudro_run() {
  local a
  local -a scrub=() envs=() timeout_cmd=()
  # macOS には timeout(1) がないため perl の alarm で上限を付ける。alarm タイマーは exec 後も
  # 残るので、perl が exec した先(env → gcloud)に SIGALRM が届く。超過時の終了コードは 142。
  if [[ $1 == -t ]]; then
    timeout_cmd=(perl -e 'alarm shift; exec @ARGV' "$2")
    shift 2
  fi
  for a in ${(k)parameters}; do
    [[ $a == CLOUDSDK_* ]] && scrub+=(-u "$a")
  done
  local -i sep=0
  while (( $# )); do
    if [[ $1 == -- ]]; then
      shift
      sep=1
      break
    fi
    envs+=("$1")
    shift
  done
  # 区切りを書き忘れると env が env 指定を command 名と解釈し分かりにくく失敗するため弾く
  if (( ! sep )); then
    print -u2 "gcloudro: 内部エラー: gcloudro_run の呼び出しに '--' がありません"
    return 2
  fi
  command "${timeout_cmd[@]}" env "${scrub[@]}" "${envs[@]}" gcloud "$@"
}

# gcloudro 専用: ユーザー認証(なりすまし抜き)が今も使えるかを終了コードで返す。
# 英語エラーメッセージのパターンマッチより壊れにくい判定として使う。
# 永続設定(~/.config/gcloud)の auth/impersonate_service_account・auth/access_token_file は
# env の除去では消えないため、空の env で明示的に無効化してユーザー認証自体を検査する。
# stdout にアクセストークンが出るので捨てる。
gcloudro_auth_ok() {
  gcloudro_run CLOUDSDK_CORE_DISABLE_PROMPTS=1 \
    CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT= CLOUDSDK_AUTH_ACCESS_TOKEN_FILE= \
    -- auth print-access-token >/dev/null 2>&1
}

# gcloudro 専用: 組織のセッションポリシーにより期限切れになったユーザー認証を再取得する。
# 認証が使える状態になったときだけ 0 を返す(呼び出し側はそのときだけコマンドを再実行する)。
gcloudro_relogin() {
  # 元コマンドの失敗原因が認証切れだったことまでは証明しないが、
  # 認証が使えないなら再ログインする方針。
  if gcloudro_auth_ok; then
    return 1  # ユーザー認証は有効 → 再ログインしない
  fi

  # ログイン先はアクティブなアカウントに固定する(ブラウザで別アカウントを選んでしまい
  # active account が入れ替わる事故を防ぐ)。特定できなければ自動ログインしない。
  local account
  # `|| account=""` は ERR_RETURN 有効時に取得失敗でそのまま抜けないようにするため
  account="$(gcloudro_run CLOUDSDK_CORE_DISABLE_PROMPTS=1 -- config get-value account 2>/dev/null)" || account=""
  if [[ ! "$account" =~ '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$' \
        || "$account" == *.gserviceaccount.com ]]; then
    print -u2 "gcloudro: 認証が切れていますが、ログイン先アカウントを特定できません。'gcloud auth login' を手動で実行してください"
    return 1
  fi

  # ブラウザ認証の待ち時間の上限。非対話(コーディングエージェント等)でもハングさせないために置く。
  # 算術評価に不正な文字列を渡さないよう、数値かつ 1〜600 秒のときだけ上書きを受け付ける。
  local -i limit=90
  [[ "$GCLOUDRO_LOGIN_TIMEOUT" == <1-600> ]] && limit=$GCLOUDRO_LOGIN_TIMEOUT

  # 並列実行(サブエージェント等)でログインタブが乱立し、それぞれが上限まで待つのを防ぐ。
  # flock はプロセス終了時に OS が解放するため、異常終了しても stale lock にならない。
  # shell snapshot 経由で復元された非対話シェルにはモジュールが読み込まれていないため毎回ロードする。
  if ! zmodload -F zsh/system b:zsystem 2>/dev/null; then
    print -u2 "gcloudro: zsh/system を読み込めないため自動ログインを中止します。'gcloud auth login' を手動で実行してください"
    return 1
  fi
  local lock_file="$HOME/.config/gcloudro/login.lock" lock_fd
  # ロック取得後に開き直すと解除されうるので、取得前に用意する
  if ! : >> "$lock_file" 2>/dev/null; then
    print -u2 "gcloudro: ロックファイルを作成できません: $lock_file"
    return 1
  fi
  if ! zsystem flock -t 0 -f lock_fd "$lock_file" 2>/dev/null; then
    print -u2 "gcloudro: 別のプロセスが再ログイン中です。完了後に再実行してください"
    return 1
  fi

  # ここから先は早期 return せず、必ず最後にロックを解放する。
  # 最初の確認からロック取得までの間に先行プロセスがログインを終えていることがあるため、もう一度確認する
  # (確認しないと、不要な --force ログインでブラウザが開いてしまう)。
  local -i rc=0
  if gcloudro_auth_ok; then
    print -u2 "gcloudro: 別のプロセスが再ログイン済みです"
  else
    print -u2 "gcloudro: 認証が切れているためブラウザで再ログインします (最大 ${limit} 秒): $account"
    # ブラウザ認証の確認プロンプトを通すため、ここでは CLOUDSDK_CORE_DISABLE_PROMPTS を付けない。
    # --force がないと保存済み credential が再利用されてブラウザフローが走らず、再認証にならない。
    # `if ! cmd` だと then 節の $? が反転後の 0 になり元の終了コードを取り落とすので if/else で受ける。
    if gcloudro_run -t $limit \
        CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT= CLOUDSDK_AUTH_ACCESS_TOKEN_FILE= \
        -- auth login --force "$account"; then
      rc=0
    else
      rc=$?
    fi
  fi
  exec {lock_fd}>&-
  if (( rc == 142 )); then  # 128+SIGALRM: 上限内に認証の完了を確認できなかった
    print -u2 "gcloudro: 待ち時間内に認証の完了を確認できませんでした。同じコマンドを再実行するか、GCLOUDRO_LOGIN_TIMEOUT (1〜600 秒) で待ち時間を延ばしてください"
  fi
  return $rc
}

gcloudro() {
  # gcloud の読み取り専用ラッパー。書き込み不可は GCP 側 IAM(読み取り専用SAへのなりすまし)が担保する。
  # ここではなりすまし設定の上書き・無効化と、認証/設定系グループを塞ぐ。
  # 認証が切れていた場合は gcloudro_relogin でログインし直して 1 度だけ再実行する。
  local a

  for a in "$@"; do
    # 認証/クレデンシャル/設定を上書き・情報漏洩しうるフラグを拒否
    case "${a%%=*}" in
      --impersonate-service-account|--access-token-file|--flags-file|--configuration|--account|--log-http)
        print -u2 "gcloudro: このフラグは使用できません: $a"
        return 1
        ;;
    esac
    # 認証/設定系グループを拒否(値スキップ不要の堅牢な判定: 該当語がトークンとして現れたら拒否)
    case "$a" in
      auth|config|init|components)
        print -u2 "gcloudro: '$a' グループは使用できません"
        return 1
        ;;
    esac
  done

  # なりすまし先の SA メールはマシンローカルの非公開ファイルから読む。
  local sa_file="$HOME/.config/gcloudro/sa_email"
  if [[ ! -r "$sa_file" ]]; then
    print -u2 "gcloudro: SA メール設定ファイルがありません: $sa_file"
    print -ru2 -- "gcloudro: 作成例: mkdir -p ${sa_file:h} && chmod 700 ${sa_file:h} && printf '%s\n' '<SA_EMAIL>' > $sa_file && chmod 600 $sa_file"
    return 1
  fi
  local sa_email
  sa_email="$(< "$sa_file")"
  # 単一行・SA メール形式のみ許可(コメント混入や壊れた値を早期に弾く)
  if [[ -z "$sa_email" || "$sa_email" == *$'\n'* \
        || ! "$sa_email" =~ '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.gserviceaccount\.com$' ]]; then
    print -u2 "gcloudro: SA メールが不正です: $sa_file"
    return 1
  fi

  # 必要な設定(プロンプト無効化・なりすまし先)だけを注入して実行する
  local -a run_env=(
    CLOUDSDK_CORE_DISABLE_PROMPTS=1
    CLOUDSDK_AUTH_IMPERSONATE_SERVICE_ACCOUNT="$sa_email"
  )
  # ERR_RETURN が有効でも ret を取り落とさないよう if 条件の中で実行する
  local -i ret
  if gcloudro_run "${run_env[@]}" -- "$@"; then
    return 0
  else
    ret=$?
  fi
  # 認証切れの復旧を試みるのは gcloud の実行時エラー(1)のみ。2=使用法エラー、
  # 126/127=起動失敗、128 以上=シグナル(Ctrl-C の 130 等)は認証と無関係なので触らない。
  if (( ret != 1 )); then
    return $ret
  fi
  if ! gcloudro_relogin; then
    return $ret
  fi
  # 再ログインできたときだけ、同じコマンドを 1 度だけ再実行する(無限ループ防止)
  gcloudro_run "${run_env[@]}" -- "$@"
}

alias x86='arch -x86_64 zsh'

# Disable Prezto make wrapper
unfunction make 2>/dev/null
